# Required in production for the protected tracker administration page.
# Use 12+ characters for the password and a separate 32+ character random secret.
SACKO_ADMIN_PASSWORD=
SACKO_SESSION_SECRET=

# Required in production for durable tracker state. These are provided by an
# Upstash Redis integration in Vercel. Legacy KV_* names are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional override. By default, state is isolated by VERCEL_ENV.
SACKO_REDIS_KEY=
